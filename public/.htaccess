# Used only for the static export on Hostinger shared hosting (LiteSpeed/Apache).
RewriteEngine On

# Force HTTPS + non-www (matches canonical URLs)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://ridgelineroofingmn.site/$1 [L,R=301]

# Legacy Duda URLs
Redirect 301 /areas-we-serve/albert-lee-mn /areas-we-serve/albert-lea-mn/
Redirect 301 /gallery /portfolio/
Redirect 301 /testimonials /
Redirect 301 /referrals /contact-us/
Redirect 301 /resources /faqs/

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
